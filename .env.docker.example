# Configuration for the Docker stack (docker-compose.yml).
#   cp .env.docker.example .env.docker
# Then fill in the values below. Never commit the filled-in .env.docker.

# ── Database ────────────────────────────────────────────────────────────────
# These create the Postgres role/db on first boot and are composed into
# DATABASE_URL automatically. The db is only reachable inside the compose
# network, but use a strong password anyway — it is a real credential.
POSTGRES_USER=vibescan
POSTGRES_PASSWORD=
POSTGRES_DB=vibescan

# ── Encryption (required) ───────────────────────────────────────────────────
# 32 random bytes, base64. Encrypts user-supplied secrets (BYO DeepSeek key).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing this makes every previously stored user secret undecryptable.
ENCRYPTION_KEY=

# ── Public origin (required) ────────────────────────────────────────────────
# Your real domain, no trailing slash. Used to build links in emails.
APP_ORIGIN=https://your-domain.example

# Browser-facing origins allowed by CORS, comma-separated. app.ts ships a
# hardcoded allowlist of the original Replit/vibescan domains, so your own
# domain must be listed here.
CORS_EXTRA_ORIGINS=https://your-domain.example

# ── Host port ───────────────────────────────────────────────────────────────
# Port published on the host. Defaults to 8090 because 8080 is commonly taken
# (Apache/Tomcat). Point your reverse proxy at this.
#
# docker-compose.yml publishes this on 127.0.0.1 only, so the app is reachable
# through your reverse proxy rather than directly from the internet on this
# port. No edit needed for a normal deploy behind Caddy/nginx.
APP_PORT=8090

# ── Trust proxy (required once you're behind Caddy/nginx) ──────────────────
# Hop count of reverse proxy in front of the app. 1 for a single Caddy/nginx —
# the standard setup in DOCKER.md. Without this, Express never sees
# X-Forwarded-Proto, so it thinks every request is plain HTTP and issues the
# session cookie WITHOUT the Secure flag — sendable over plaintext even though
# the browser only ever saw HTTPS. Deliberately not a wildcard "trust
# everything" value: the /login rate limiter keys on X-Forwarded-For, and
# trusting an arbitrary number of hops would let a client spoof that header and
# dodge the limit.
TRUST_PROXY=1

# ── DeepSeek AI (required for Deep scans) ───────────────────────────────────
# https://platform.deepseek.com/ — without a valid key, deep scans still run
# but AI analysis fails with a 401 and reports come back without their
# plain-English write-up.
DEEPSEEK_API_KEY=

# ── Stripe ──────────────────────────────────────────────────────────────────
# Payments are not implemented: scans are queued free whatever this says.
# Leave it "true" so the setting matches the behaviour.
# Set it to false and fill these in to take real payments.
DISABLE_PAYMENTS=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email (strongly recommended — Resend) ───────────────────────────────────
# https://resend.com/api-keys — powers three things: scan-completion
# notifications, and password-reset / email-verification links. Without this
# set, those links are minted and silently NOT delivered — the mailer logs a
# warning and returns rather than failing the request, so nothing looks broken
# until a real user tries to recover a forgotten password and nothing arrives.
RESEND_API_KEY=

# ── Out-of-band SSRF detection (optional) ───────────────────────────────────
# The base URL a scanned target's server calls back to when it fetches a URL
# the scanner planted — this is how SSRF is detected. Must be publicly
# reachable by the targets you scan. Defaults to APP_ORIGIN when unset; leave
# both unset (or on localhost) and SSRF detection is simply skipped.
OOB_BASE_URL=

# ── Abuse and cost control (optional; defaults shown) ────────────────────────
# A scan launches a browser and runs sustained outbound traffic, so these bound
# what one client can spend on your behalf. Burst is per-IP per minute; the
# daily limits are per user and counted in Postgres, so they hold across
# replicas and restarts.
SCAN_BURST_LIMIT=5
SCAN_DAILY_LIMIT_ANON=10
SCAN_DAILY_LIMIT_ACCOUNT=50

# ── Scanning your own network (optional) ─────────────────────────────────────
# Off by default: the scanner refuses targets that resolve to private, loopback
# or link-local addresses, on the first request and on every redirect, because
# a hosted scanner that will fetch any address is an SSRF proxy. Set this only
# on a self-hosted instance where scanning your own internal estate is the
# point, and where you trust everyone who can submit a scan.
# ALLOW_PRIVATE_SCAN_TARGETS=true

# ── Alerting (optional) ──────────────────────────────────────────────────────
# Both services log a structured fatal record on an uncaught exception or
# unhandled rejection. Set this to also receive one POST when that happens —
# any Slack/Discord-compatible incoming webhook. Must be https.
# ALERT_WEBHOOK_URL=

# ── Backups (optional; defaults shown) ───────────────────────────────────────
# The backup service dumps the database into the `backups` volume on this
# interval and prunes dumps older than KEEP_DAYS. This is not off-site backup —
# copy that volume somewhere else on a schedule you control.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14

# ── Resource limits (optional; defaults shown) ───────────────────────────────
# secscan runs Chromium against untrusted pages, the workload most likely to
# balloon. Capping it means the scanner is restarted rather than taking the
# host down with it.
SECLAYER_MEM_LIMIT=768m
SECSCAN_MEM_LIMIT=3g

# ── Behind Cloudflare ────────────────────────────────────────────────────────
# Set when the origin is reachable only through Cloudflare. It makes the rate
# limiters identify callers by CF-Connecting-IP, which Cloudflare sets and
# strips from anything a client sends, so it cannot be forged. Leave it unset
# on an origin that can be reached directly — there the header is just another
# value a client can type, and trusting it would be worse than ignoring it.
#
# Pair this with restricting the origin firewall to Cloudflare's IP ranges.
# Otherwise anyone who learns the origin address can bypass Cloudflare entirely,
# and every protection that depends on it goes with them.
# BEHIND_CLOUDFLARE=true

# Hops of reverse proxy in front of the app. Cloudflare plus a local Caddy or
# nginx is two. This governs whether Express believes the request was HTTPS and
# therefore whether the session cookie gets the Secure flag; with
# BEHIND_CLOUDFLARE set, caller identity no longer depends on getting this
# number exactly right.
# TRUST_PROXY=2

# ── Google Search Console ────────────────────────────────────────────────────
# Only needed for the HTML-file verification method. Prefer the DNS TXT record
# instead when DNS is at Cloudflare: it survives redeploys, host moves and
# frontend rebuilds, and needs no application configuration at all.
#
# If you do use the file method, set this to the token Google gives you (the
# part after "google" in googleXXXX.html) and the server will answer that path.
# GOOGLE_SITE_VERIFICATION=

# ── Behind a managed platform (Railway, Fly, Render) ─────────────────────────
# On a server you own, the origin is firewalled to Cloudflare's ranges and a
# request arriving at all is proof it came through Cloudflare. A managed
# platform keeps its own public hostname, so that proof does not exist and
# CF-Connecting-IP could be forged by anyone talking to the platform directly.
#
# Set this to a random string and add a Cloudflare Transform Rule that sets the
# X-Origin-Secret header to the same value on every incoming request. Only
# requests carrying it are treated as having come through Cloudflare; the rest
# fall back to req.ip. Nothing is rejected on this basis, so platform health
# checks keep working.
#   openssl rand -hex 32
# CLOUDFLARE_ORIGIN_SECRET=
