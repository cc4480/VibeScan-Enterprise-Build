{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "dev:secscan": "export NODE_ENV=development && pnpm run build && pnpm run start:secscan",
    "build": "node ./build.mjs",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps ./dist/index.mjs",
    "start:secscan": "node --env-file-if-exists=../../.env --enable-source-maps ./dist/secscan.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docs:checks": "node ./scripts/check-index.mjs",
    "benchmark": "npx tsx ./scripts/benchmark/run-benchmark.ts",
    "benchmark:packet": "npx tsx ./scripts/benchmark/build-judge-packet.ts",
    "benchmark:score": "npx tsx ./scripts/benchmark/score-consensus.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opentelemetry/api": "^1.9.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "openid-client": "^6.8.8",
    "pg-boss": "^12.37.0",
    "pino": "^9",
    "pino-http": "^10",
    "playwright": "^1.64.0",
    "stripe": "^23.0.0",
    "undici": "^7.30.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "http-proxy-middleware": "^4.2.0",
    "pino-pretty": "^13",
    "supertest": "^7.3.1",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.8"
  }
}
