# SecScan (secscan.us): read by both secscan-web and secscan-worker.
#
# Copy the values from Railway: secscan project -> web service -> Variables ->
# Raw Editor. Never copy RAILWAY_* variables. DATABASE_URL, PORT, NODE_ENV,
# TRUST_PROXY and BEHIND_CLOUDFLARE are set by docker-compose.yml and anything
# here for them is ignored. CLOUDFLARE_ORIGIN_SECRET is not needed behind a tunnel.

# REQUIRED. The exact value from Railway. A different key cannot decrypt the
# scan credentials and signed links already stored in the database.
ENCRYPTION_KEY=

# REQUIRED.
APP_ORIGIN=https://secscan.us

# REQUIRED. Every sign-in and every sign-up emails a 6-digit code; without this
# nobody can log in or register.
RESEND_API_KEY=

# Optional: uncomment the ones you had set on Railway.
# DEEPSEEK_API_KEY=
# AUTH_FROM_EMAIL=
# REPLY_TO_EMAIL=
# RESEND_WEBHOOK_SECRET=
# RESEND_AUDIENCE_ID=
# RESEND_AUDIENCE_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_SITE_VERIFICATION=
# NVD_API_KEY=
# OOB_BASE_URL=
# LEGACY_BEARER_SUNSET=
# Chromium's sandbox is ON by default (the renderer runs scanned pages). Leave this unset.
# If the container cannot create the user namespaces the sandbox needs, Chromium falls back to
# --no-sandbox and logs an error saying so. Set CHROMIUM_SANDBOX=false to choose that explicitly
# (any other value, or unset, keeps the sandbox on).
# CHROMIUM_SANDBOX=false

# Payments stay off: leave these unset.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
