# complyscan.
#
# Copy the values from Railway (the complyscan service -> Variables -> Raw
# Editor). Never copy RAILWAY_* variables. DATABASE_URL and PORT are set by
# docker-compose.yml.

# REQUIRED. FLASK_SECRET_KEY and ENCRYPTION_KEY must be the exact values from
# Railway: a new FLASK_SECRET_KEY signs everyone out, and a new ENCRYPTION_KEY
# cannot decrypt what is already stored.
FLASK_SECRET_KEY=
ENCRYPTION_KEY=
ADMIN_SEED_TOKEN=

# REQUIRED: the public address the app is served from.
FRONTEND_ORIGIN=

# Optional: uncomment the ones you had set on Railway.
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=
# DEEPSEEK_MODEL=
# GITHUB_WEBHOOK_SECRET=
# SENTRY_DSN=
# EVIDENCE_MAX_UPLOAD_MB=
# RATELIMIT_STORAGE_URI=
