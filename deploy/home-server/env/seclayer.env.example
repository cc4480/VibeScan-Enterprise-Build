# seclayer.
#
# Copy the values from Railway (the seclayer service -> Variables -> Raw Editor).
# Never copy RAILWAY_* variables: with RAILWAY_ENVIRONMENT set, seclayer trusts
# every X-Forwarded-For hop, which lets visitors fake their IP address.
# DATABASE_URL, PORT and NODE_ENV are set by docker-compose.yml.

# REQUIRED: the public address, used to build sign-in and checkout links.
APP_URL=https://seclayer.app

# REQUIRED in production: seclayer refuses to start without an email provider.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: uncomment the ones you had set on Railway.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL_FLASH=
# DEEPSEEK_MODEL_PRO=
# APP_VERSION=
# HEALTH_DETAIL_TOKEN=
# SECURITY_CONTACT=
# SECURITY_POLICY_URL=
# ENABLE_BROWSER_RENDERING=
# ENABLE_TARGET_SCREENSHOT=
# FREE_MODE=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
