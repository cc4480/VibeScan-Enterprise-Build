# SEO-scan-Pro.
#
# Copy the values from Railway (the SEO-scan-Pro service -> Variables -> Raw
# Editor). Never copy RAILWAY_* variables. DATABASE_URL, PORT, NODE_ENV,
# TRUST_PROXY_HOPS and SCAN_CONCURRENCY are set by docker-compose.yml.

# REQUIRED: the public address.
APP_URL=

# REQUIRED. The exact value from Railway, or everyone is signed out.
JWT_SECRET=

# Email (password resets and notices).
RESEND_API_KEY=
EMAIL_FROM=
# SUPPORT_EMAIL=

# Optional: uncomment the ones you had set on Railway.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=
# JWT_EXPIRY=
# DAILY_SCAN_LIMIT=
# MAX_PENDING_SCANS=
# COMPED_EMAILS=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
