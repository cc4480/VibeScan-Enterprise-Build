# Stack-wide settings. setup.ps1 copies this to .env and fills in every
# password with a random value; you only add the tunnel token by hand.
# .env is git-ignored: never commit it.

# Where the five app repositories sit, relative to this folder.
APPS_DIR=../../..

# Database passwords: letters and digits only (they go inside connection URLs).
POSTGRES_PASSWORD=
SECSCAN_DB_PASSWORD=
SECLAYER_DB_PASSWORD=
COMPLYSCAN_DB_PASSWORD=
SEOSCAN_DB_PASSWORD=

# From the Cloudflare dashboard (README.md, step 6). Then uncomment the next
# line so `docker compose up -d` also starts the tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
# COMPOSE_PROFILES=tunnel

# How many scans each scanner runs at the same time.
SECSCAN_SCAN_CONCURRENCY=3
SEOSCAN_SCAN_CONCURRENCY=2

# Database backups: once a day, kept for 14 days, in the backups folder here.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14
