{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "node --enable-source-maps artifacts/api-server/dist/secscan.mjs",
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  }
}
