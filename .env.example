# ── Database ────────────────────────────────────────────────────────────────
# Replit provides this automatically. For local dev, set your own PostgreSQL URL.
DATABASE_URL=postgresql://user:password@localhost:5432/vibescan

# ── Stripe ──────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Webhook secret — from `stripe listen --forward-to localhost:<PORT>/api/scan/webhook`
# or from the Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# ── DeepSeek AI ─────────────────────────────────────────────────────────────
# Get from https://platform.deepseek.com/
# Fallback key used when a user hasn't configured their own key in Settings.
DEEPSEEK_API_KEY=sk-...

# ── Encryption (user-supplied secrets, e.g. BYO DeepSeek key) ────────────────
# 32-byte key, base64-encoded. Required for the "add your own DeepSeek key"
# settings feature — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ── Email (optional — Resend) ────────────────────────────────────────────────
# Get from https://resend.com/api-keys
# Required only to send completion email notifications for Deep/Pack scans.
RESEND_API_KEY=re_...

# ── App origin ───────────────────────────────────────────────────────────────
# Used to construct links in email notifications. Must NOT have a trailing slash.
APP_ORIGIN=https://secscan.us

# ── Development flags ────────────────────────────────────────────────────────
# Payments are not wired up: scans are queued free regardless of this value.
# Kept so the setting is not silently dropped from existing environments.
DISABLE_PAYMENTS=true

# Set to "0" to disable TLS certificate rejection — ONLY for dev environments
# that use self-signed or untrusted certs (e.g. Replit sandbox)
# NODE_TLS_REJECT_UNAUTHORIZED=0
