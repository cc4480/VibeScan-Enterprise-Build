# Copy to `.env` at the repo root and fill in. Loaded automatically by the API
# server (`--env-file-if-exists`); real environment variables always win, so
# this file is ignored on Replit. `.env` is gitignored — never commit it.
# Note: `db:push` shells out to drizzle-kit, which reads the shell environment
# only — export DATABASE_URL for that command.

# ── Server ──────────────────────────────────────────────────────────────────
# Required — the API server refuses to boot without it. The frontend dev server
# proxies /api to localhost:8080, so keep this at 8080 for local development.
# Docker Compose sets this itself; leave it alone there.
PORT=8080

# ── Public identity ─────────────────────────────────────────────────────────
# The domain this deployment is served from. No trailing slash.
#
# This is BUILD-time as well as run-time for Docker: the frontend bakes it into
# canonical links, Open Graph tags, JSON-LD and the sitemap, so changing it
# means rebuilding the image, not just restarting it. A canonical tag naming a
# domain you do not own tells search engines the content belongs to someone
# else, so this must be right before the site is indexed.
APP_ORIGIN=https://secscan.us

# From address for notification email. Must be on a domain verified with your
# email provider or the messages are rejected. Defaults to reports@<APP_ORIGIN
# host>, so set this only if the mailbox lives elsewhere.
# FROM_EMAIL=Seclayer <reports@secscan.us>

# User-Agent for outbound scan traffic. Site owners who see this in their logs
# follow the URL to find out who is probing them, so the page it names should
# exist. Defaults to a Seclayer bot string pointing at APP_ORIGIN/bot.
# SCANNER_USER_AGENT=

# ── Abuse limits ────────────────────────────────────────────────────────────
# Scan creation is rate limited per client address. Client tokens are
# self-minted UUIDs, so the address is the only durable identity to count.
# A deep scan is 300-500+ outbound requests and (with a DeepSeek key) an AI
# call, so an unlimited endpoint can be used to attack a third party or run up
# your bill. Defaults: 5/hour, 20/day.
# SCAN_LIMIT_PER_HOUR=5
# SCAN_LIMIT_PER_DAY=20

# How many reverse proxies sit in front of the app. Defaults to 1 in production
# (the compose stack's Caddy) and 0 in development.
#
# ⚠️  Getting this wrong breaks rate limiting silently, in one of two ways:
#   - Too high, or "true", with nothing actually in front: callers set their own
#     X-Forwarded-For and get a fresh bucket per request. Verified bypassable.
#   - Too low behind a proxy: every caller shares the proxy's address, so one
#     user's traffic rate-limits everybody.
# The compose stack is correct as shipped: Caddy overwrites X-Forwarded-For with
# the real peer, and the app port is never published, so the app cannot be
# reached except through Caddy. If you put the app behind something else, set
# this to the real hop count and make that proxy overwrite the header too.
# TRUST_PROXY=1

# ── Docker Compose only ─────────────────────────────────────────────────────
# Ignored outside compose. DATABASE_URL is assembled from these; do not set
# DATABASE_URL yourself when using compose.
POSTGRES_USER=seclayer
POSTGRES_DB=seclayer
# Required. Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# Required. Let's Encrypt sends certificate-expiry warnings here.
TLS_EMAIL=

# ── Database ────────────────────────────────────────────────────────────────
# Replit provides this automatically. For local dev, set your own PostgreSQL URL.
DATABASE_URL=postgresql://user:password@localhost:5432/vibescan

# ── Stripe (optional — dormant) ─────────────────────────────────────────────
# All scans are free during early access: POST /scans queues immediately and
# never returns a checkout URL. The Stripe route and webhook are still wired up
# but unreachable in that flow, so leave these unset unless reviving billing.
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Webhook secret — from `stripe listen --forward-to localhost:<PORT>/api/scan/webhook`
# or from the Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# ── DeepSeek AI ─────────────────────────────────────────────────────────────
# Get from https://platform.deepseek.com/
# Fallback key used when a user hasn't configured their own key in Settings.
DEEPSEEK_API_KEY=sk-...

# ── Encryption (user-supplied secrets, e.g. BYO DeepSeek key) ────────────────
# 32-byte key, base64-encoded. Required for the "add your own DeepSeek key"
# settings feature — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ── Email (optional — Resend) ────────────────────────────────────────────────
# Get from https://resend.com/api-keys
# Required only to send completion email notifications for Deep/Pack scans.
RESEND_API_KEY=re_...

# ── App origin ───────────────────────────────────────────────────────────────
# Used to construct links in email notifications. Must NOT have a trailing slash.
APP_ORIGIN=https://secscan.us

# ── Development flags ────────────────────────────────────────────────────────
# Payments are not wired up: scans are queued free regardless of this value.
# Kept so the setting is not silently dropped from existing environments.
DISABLE_PAYMENTS=true

# Set to "0" to disable TLS certificate rejection — ONLY for dev environments
# that use self-signed or untrusted certs (e.g. Replit sandbox)
# NODE_TLS_REJECT_UNAUTHORIZED=0
