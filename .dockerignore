# Build context hygiene — everything here is either rebuilt inside the image,
# host-specific, or a secret that must never land in a layer.

.git
.gitignore

# Installed and built artefacts are regenerated by the builder stage.
node_modules
**/node_modules
dist
**/dist
*.tsbuildinfo
**/*.tsbuildinfo

# Secrets. .env holds a real ENCRYPTION_KEY and API keys; the container gets
# its configuration from compose/env at run time instead.
.env
.env.*
!.env.example
!.env.production.example
!.env.docker.example

# Host/editor/CI noise
.claude
.vscode
.idea
*.log
npm-debug.log*
Dockerfile
.dockerignore
docker-compose.yml

# Database dumps and migration snapshots. Neither is needed to build or run an image, and a dump
# of real data baked into a layer would outlive the server it came from. lib/db/migrations/*.sql
# is NOT matched by these patterns: the builder copies it, and the runtime stage ships it.
deploy/home-server/migration/
backups/
deploy/**/*.dump
deploy/**/*.sql.gz
deploy/**/*.sql
backups/**/*.dump
backups/**/*.sql.gz
backups/**/*.sql
