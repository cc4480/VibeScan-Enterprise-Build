# Build context hygiene — everything here is either rebuilt inside the image,
# host-specific, or a secret that must never land in a layer.

.git
.gitignore

# Installed and built artefacts are regenerated by the builder stage.
node_modules
**/node_modules
dist
**/dist
*.tsbuildinfo
**/*.tsbuildinfo

# Secrets. .env holds a real ENCRYPTION_KEY and API keys; the container gets
# its configuration from compose/env at run time instead.
.env
.env.*
!.env.example
!.env.production.example
!.env.docker.example

# Host/editor/CI noise
.claude
.replit
.replitignore
.vscode
.idea
*.log
npm-debug.log*
Dockerfile
.dockerignore
docker-compose.yml
