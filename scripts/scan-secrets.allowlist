# Files scripts/scan-secrets.sh is told to skip. One exact repo-relative path per line;
# blank lines and '#' comments are ignored. There are no globs: allowing a file means
# reading it first and saying here why its matches are not real credentials.
#
# This repository is a vulnerability scanner, so its detection tests and docs have to
# contain strings shaped like real credentials. Every file below was inspected: the
# matches are planted fakes, vendor-documented example values, or comments quoting a
# pattern, not live credentials. artifacts/vuln-fixture/ is excluded wholesale in the script (it
# holds planted faults by design). __fixtures__/ directories are scanned like everything else;
# the hits they produce, if any, are listed below one file at a time.
#
# Adding a file is a review decision. If a new test needs a fake key, prefer one that
# already looks fake (EXAMPLE, test, xxxx) so it never needs an entry at all.

# Planted fake AWS key id inside the detection-check fixture site.
artifacts/api-server/scripts/detection-check.ts

# Fake Stripe live key in an env-file test of "real secrets beside public ones".
artifacts/api-server/src/lib/configSecrets.test.ts

# Fake AWS/Stripe values fed to the LLM redaction tests, plus AWS's documented example key.
artifacts/api-server/src/lib/deepseek.test.ts

# Fake Stripe-shaped strings used to check that fix prompts redact secret-shaped text.
artifacts/api-server/src/lib/fixPromptFallback.test.ts

# Mocked .env.example responses with fake Stripe-shaped values (GitHub source probe).
artifacts/api-server/src/lib/githubSourceProbe.hardening.test.ts
artifacts/api-server/src/lib/githubSourceProbe.test.ts

# Fake Stripe live key and AWS key id used to assert the JS scanner finds and redacts them.
artifacts/api-server/src/lib/jsScanner.test.ts

# PEM header text used to test the private-key pattern (a bare header and a fake body).
artifacts/api-server/src/lib/secret-pattern-data.test.ts

# Comment quoting the header JSEncrypt embeds, explaining why the bare header is not a finding.
artifacts/api-server/src/lib/secret-pattern-vendors.ts

# Fake AWS/Stripe-shaped values in the false-positive guard tests.
artifacts/api-server/src/lib/secretFalsePositives.test.ts

# Doc comment listing placeholder values (sk_live_xxxx...) and AWS's documented example key.
artifacts/api-server/src/lib/secretPlaceholders.ts

# Fake Stripe/GitHub/AWS credentials that the placeholder filter must keep reporting.
artifacts/api-server/src/lib/secretPlaceholders.test.ts

# Fake Stripe-shaped keys in the repository-scan tests: the scan must keep reporting them.
artifacts/api-server/src/lib/repoScan.test.ts
artifacts/api-server/src/lib/repoScan.scan.test.ts
artifacts/api-server/src/lib/repoScanRecord.test.ts

# A DATABASE_URL with a lowercase-word password inside an .env body written as a test string, next
# to a deliberately fake STRIPE_SECRET_KEY. The repo-scan rule tests need a DATABASE_URL line to
# exercise the rule; the value appears nowhere else in the repository.
artifacts/api-server/src/lib/repoCodeRules.test.ts
