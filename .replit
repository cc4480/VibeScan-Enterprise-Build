modules = ["nodejs-24", "postgresql-16", "python-3.11"]

  [[artifacts]]
  id = "artifacts/api-server"

  [[artifacts]]
  id = "artifacts/mockup-sandbox"

  [deployment]
  router = "application"
  deploymentTarget = "autoscale"

  [deployment.postBuild]
  args = ["pnpm", "store", "prune"]
  env = { "CI" = "true" }

  [workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 pnpm --filter @workspace/vibescan run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

  [agent]
  stack = "BEST_EFFORT_FALLBACK"
expertMode = true

  [postMerge]
  path = "scripts/post-merge.sh"
  timeoutMs = 20000

  [userenv]

  [userenv.development]
  DISABLE_PAYMENTS = "true"
  NODE_TLS_REJECT_UNAUTHORIZED = "0"

  [userenv.production]
  DISABLE_PAYMENTS = "true"

  [nix]
  channel = "stable-25_05"

[[ports]]
localPort = 3000
externalPort = 3000
  