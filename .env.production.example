# ─────────────────────────────────────────────────────────────────────────────
# Production environment template for Seclayer / VibeScan.
# Copy to your host's secret store (NOT into git). .env* is gitignored.
# Every value below is a placeholder — replace before deploying.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime — REQUIRED. NODE_ENV=production is what activates the full frontend
# security header set (CSP, HSTS, COEP, X-Frame-Options) and static file serving.
NODE_ENV=production
PORT=8080

# Public origin of the deployed app, no trailing slash. Used in report/email links.
APP_ORIGIN=https://secscan.us

# Database — REQUIRED. Your production PostgreSQL 16 (managed instance, not local).
# Run `pnpm --filter @workspace/db run db:push` against this DB before first boot.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Encryption — REQUIRED for the BYO-DeepSeek-key feature. 32-byte base64 key.
# Generate ONCE and keep it stable forever: if it changes, every user-stored
# encrypted key becomes permanently undecryptable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# DeepSeek — fallback AI key for Deep-scan reports (users can also BYO in Settings).
# Rotate any key that has ever been shared in plaintext.
DEEPSEEK_API_KEY=

# Stripe — payments are NOT implemented end to end. The webhook that credits an
# account exists, but nothing creates a Checkout Session, so no customer can
# reach it: every scan is queued free of charge whatever this is set to.
#
# Leave it "true" so the configuration matches the behaviour. Setting "false"
# does not start charging anyone — it only logs a warning at startup. The keys
# below are still worth setting if you are building checkout.
DISABLE_PAYMENTS=true
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Resend) — report-ready / CVE / regression notifications. Optional but
# recommended; the app degrades gracefully if unset.
RESEND_API_KEY=re_...

# Headless browser (SPA rendering) — optional. Leave PLAYWRIGHT_BROWSERS_PATH
# unset to use Playwright's default location, or point it at a directory where
# `playwright install chromium` (matching this project's Playwright version) has
# run. Do NOT hardcode a browser revision anywhere — Playwright resolves it.
# PLAYWRIGHT_BROWSERS_PATH=

# NEVER set NODE_TLS_REJECT_UNAUTHORIZED=0 in production — it disables TLS verification.

# ── Behind Cloudflare ────────────────────────────────────────────────────────
# Set when the origin is reachable only through Cloudflare. It makes the rate
# limiters identify callers by CF-Connecting-IP, which Cloudflare sets and
# strips from anything a client sends, so it cannot be forged. Leave it unset
# on an origin that can be reached directly — there the header is just another
# value a client can type, and trusting it would be worse than ignoring it.
#
# Pair this with restricting the origin firewall to Cloudflare's IP ranges.
# Otherwise anyone who learns the origin address can bypass Cloudflare entirely,
# and every protection that depends on it goes with them.
# BEHIND_CLOUDFLARE=true

# Hops of reverse proxy in front of the app. Cloudflare plus a local Caddy or
# nginx is two. This governs whether Express believes the request was HTTPS and
# therefore whether the session cookie gets the Secure flag; with
# BEHIND_CLOUDFLARE set, caller identity no longer depends on getting this
# number exactly right.
# TRUST_PROXY=2

# ── Google Search Console ────────────────────────────────────────────────────
# Only needed for the HTML-file verification method. Prefer the DNS TXT record
# instead when DNS is at Cloudflare: it survives redeploys, host moves and
# frontend rebuilds, and needs no application configuration at all.
#
# If you do use the file method, set this to the token Google gives you (the
# part after "google" in googleXXXX.html) and the server will answer that path.
# GOOGLE_SITE_VERIFICATION=

# ── Behind a managed platform (Railway, Fly, Render) ─────────────────────────
# On a server you own, the origin is firewalled to Cloudflare's ranges and a
# request arriving at all is proof it came through Cloudflare. A managed
# platform keeps its own public hostname, so that proof does not exist and
# CF-Connecting-IP could be forged by anyone talking to the platform directly.
#
# Set this to a random string and add a Cloudflare Transform Rule that sets the
# X-Origin-Secret header to the same value on every incoming request. Only
# requests carrying it are treated as having come through Cloudflare; the rest
# fall back to req.ip. Nothing is rejected on this basis, so platform health
# checks keep working.
#   openssl rand -hex 32
# CLOUDFLARE_ORIGIN_SECRET=

# ── Sign in with Google (optional) ───────────────────────────────────────────
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
#   Application type:            Web application
#   Authorised redirect URI:     https://secscan.us/api/auth/google/callback
#
# The redirect URI must match exactly, including scheme and no trailing slash.
# The app builds it from APP_ORIGIN rather than from the request, so a wrong
# APP_ORIGIN shows up here as redirect_uri_mismatch from Google.
#
# Both routes return 503 rather than 404 when these are unset, so a missing
# variable is distinguishable from a bad build.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
