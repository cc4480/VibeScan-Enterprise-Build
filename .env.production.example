# ─────────────────────────────────────────────────────────────────────────────
# Production environment template for SecScan (repo: VibeScan-Enterprise-Build).
# Copy to your host's secret store (NOT into git). .env* is gitignored.
# Every value below is a placeholder — replace before deploying.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime — REQUIRED. NODE_ENV=production is what activates the full frontend
# security header set (CSP, HSTS, COEP, X-Frame-Options) and static file serving.
NODE_ENV=production
PORT=8080

# Public origin of the deployed app, no trailing slash. Used in report/email links.
APP_ORIGIN=https://secscan.us

# Database — REQUIRED. Your production PostgreSQL 16 (managed instance, not local).
# Run `pnpm --filter @workspace/db run db:push` against this DB before first boot.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Encryption — REQUIRED (the process refuses to start without it). 32-byte base64 key.
# Seals stored scan credentials. Generate ONCE and keep it stable: if it changes,
# every stored scan login becomes permanently undecryptable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# DeepSeek — the AI key for report analysis.
# Rotate any key that has ever been shared in plaintext.
DEEPSEEK_API_KEY=

# Stripe — payments are ON exactly when STRIPE_SECRET_KEY is set. Set it and
# STRIPE_WEBHOOK_SECRET together (a key alone takes money it cannot credit; the
# server logs an error at boot). There is no DISABLE_PAYMENTS switch — to run
# without payments, leave both unset. Setup: deploy/PAYMENTS-GO-LIVE.md
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Resend) — report-ready / CVE / regression notifications. Optional but
# recommended; the app degrades gracefully if unset.
RESEND_API_KEY=re_...

# Headless browser (SPA rendering) — optional. Leave PLAYWRIGHT_BROWSERS_PATH
# unset to use Playwright's default location, or point it at a directory where
# `playwright install chromium` (matching this project's Playwright version) has
# run. Do NOT hardcode a browser revision anywhere — Playwright resolves it.
# PLAYWRIGHT_BROWSERS_PATH=

# NEVER set NODE_TLS_REJECT_UNAUTHORIZED=0 in production — it disables TLS verification.

# ── Behind Cloudflare ────────────────────────────────────────────────────────
# Set when the origin is reachable only through Cloudflare. It makes the rate
# limiters identify callers by CF-Connecting-IP, which Cloudflare sets and
# strips from anything a client sends, so it cannot be forged. Leave it unset
# on an origin that can be reached directly — there the header is just another
# value a client can type, and trusting it would be worse than ignoring it.
#
# Pair this with restricting the origin firewall to Cloudflare's IP ranges.
# Otherwise anyone who learns the origin address can bypass Cloudflare entirely,
# and every protection that depends on it goes with them.
# BEHIND_CLOUDFLARE=true

# Hops of reverse proxy in front of the app. Cloudflare plus a local Caddy or
# nginx is two. This governs whether Express believes the request was HTTPS and
# therefore whether the session cookie gets the Secure flag; with
# BEHIND_CLOUDFLARE set, caller identity no longer depends on getting this
# number exactly right.
# TRUST_PROXY=2

# ── Google Search Console ────────────────────────────────────────────────────
# Only needed for the HTML-file verification method. Prefer the DNS TXT record
# instead when DNS is at Cloudflare: it survives redeploys, host moves and
# frontend rebuilds, and needs no application configuration at all.
#
# If you do use the file method, set this to the token Google gives you (the
# part after "google" in googleXXXX.html) and the server will answer that path.
# GOOGLE_SITE_VERIFICATION=

# ── Behind a managed platform (Railway, Fly, Render) ─────────────────────────
# On a server you own, the origin is firewalled to Cloudflare's ranges and a
# request arriving at all is proof it came through Cloudflare. A managed
# platform keeps its own public hostname, so that proof does not exist and
# CF-Connecting-IP could be forged by anyone talking to the platform directly.
#
# Set this to a random string and add a Cloudflare Transform Rule that sets the
# X-Origin-Secret header to the same value on every incoming request. Only
# requests carrying it are treated as having come through Cloudflare; the rest
# fall back to req.ip. Nothing is rejected on this basis, so platform health
# checks keep working.
#   openssl rand -hex 32
# CLOUDFLARE_ORIGIN_SECRET=

# ── Sign in with Google (optional) ───────────────────────────────────────────
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
#   Application type:            Web application
#   Authorised redirect URI:     https://secscan.us/api/auth/google/callback
#
# The redirect URI must match exactly, including scheme and no trailing slash.
# The app builds it from APP_ORIGIN rather than from the request, so a wrong
# APP_ORIGIN shows up here as redirect_uri_mismatch from Google.
#
# Both routes return 503 rather than 404 when these are unset, so a missing
# variable is distinguishable from a bad build.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Also read by the code (all optional unless marked) ─────────────────────
# ENCRYPTION_KEY is REQUIRED in production: the process refuses to start without it. Base64, 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it with your database backups; without it stored logins cannot be decrypted.
# ENCRYPTION_KEY=
# To rotate: put the new key in ENCRYPTION_KEY and the old one in ENCRYPTION_KEY_PREVIOUS (comma-separated for more
# than one) so stored secrets still open; remove the old key once nothing stored under it remains.
# ENCRYPTION_KEY_PREVIOUS=
#
# Set on the WEB service so bounce and complaint webhooks are accepted (they answer 503 without it):
# RESEND_WEBHOOK_SECRET=
# Email: without RESEND_API_KEY no email is sent and sign-in codes never arrive.
# AUTH_FROM_EMAIL=
# REPLY_TO_EMAIL=
# RESEND_AUDIENCE_ID=
# RESEND_AUDIENCE_API_KEY=
# TRUST_PROXY=1            # behind Railway's proxy; needed for correct client IPs and Secure cookies
#
# AI analysis: without DEEPSEEK_API_KEY reports are produced with no written analysis.
# DEEPSEEK_MODEL=
# DEEPSEEK_SEND_EVIDENCE=false   # send finding names and descriptions only, no evidence text
# NVD_API_KEY=                   # higher NVD rate limit for CVE matching
#
# Limits and tuning (defaults are in the code):
# SCAN_WORKER_CONCURRENCY=8
# SCAN_LIMIT_PER_HOUR_PER_IP=
# SCAN_LIMIT_PER_DAY_PER_IP=
# SIGNUP_LIMIT_WINDOW_DAYS=
# FREE_TRIAL_SCAN_LIMIT=3
# DB_POOL_MAX=
# MIGRATION_LOCK_TIMEOUT_MS=
# OSV_CACHE_MAX_SIZE=
# HEARTBEAT_FILE=
#
# Never set these in production: ALLOW_UNVERIFIED_ACTIVE_PROBES lets any user run active probes against any
# host; DEV_SKIP_DOMAIN_VERIFICATION is for development only.
# ALLOW_PRIVATE_SCAN_TARGETS lets scans (and the scanner's browser) reach private addresses.
#
# Legacy anonymous bearer (an old anonymous account's user id used as its only credential). Still honoured
# for existing anonymous rows by default, so pre-registration users are not cut off. Every use is logged at
# warn (search the web logs for legacy_anonymous_bearer). To retire it: watch the logs, set
# LEGACY_BEARER_SUNSET, then set ALLOW_LEGACY_ANONYMOUS_BEARER=false. That one always wins; see
# deploy/railway/README.md.
# LEGACY_BEARER_SUNSET=2026-12-01   # ISO 8601, UTC if no offset: rejected from that moment. Unset = never.
# ALLOW_LEGACY_ANONYMOUS_BEARER=false   # close it now, whatever the sunset says

# SSLLABS_ENABLED=true also requests a Qualys SSL Labs grade for each HTTPS scan. Off by default: Qualys's terms
# require their permission for commercial use, and the API version used (v3) is deprecated. Every HTTPS scan
# already runs the scanner's own TLS configuration check (protocols, certificate, cipher suite) without it.
# SSLLABS_ENABLED=
