# ─────────────────────────────────────────────────────────────────────────────
# Production environment template for Seclayer / VibeScan.
# Copy to your host's secret store (NOT into git). .env* is gitignored.
# Every value below is a placeholder — replace before deploying.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime — REQUIRED. NODE_ENV=production is what activates the full frontend
# security header set (CSP, HSTS, COEP, X-Frame-Options) and static file serving.
NODE_ENV=production
PORT=8080

# Public origin of the deployed app, no trailing slash. Used in report/email links.
APP_ORIGIN=https://seclayer.app

# Database — REQUIRED. Your production PostgreSQL 16 (managed instance, not local).
# Run `pnpm --filter @workspace/db run db:push` against this DB before first boot.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Encryption — REQUIRED for the BYO-DeepSeek-key feature. 32-byte base64 key.
# Generate ONCE and keep it stable forever: if it changes, every user-stored
# encrypted key becomes permanently undecryptable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# DeepSeek — fallback AI key for Deep-scan reports (users can also BYO in Settings).
# Rotate any key that has ever been shared in plaintext.
DEEPSEEK_API_KEY=

# Stripe — payments. Set DISABLE_PAYMENTS=false in production, configure a webhook
# to POST https://<APP_ORIGIN>/api/scan/webhook, and paste its signing secret.
DISABLE_PAYMENTS=false
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Resend) — report-ready / CVE / regression notifications. Optional but
# recommended; the app degrades gracefully if unset.
RESEND_API_KEY=re_...

# Headless browser (SPA rendering) — optional. Leave PLAYWRIGHT_BROWSERS_PATH
# unset to use Playwright's default location, or point it at a directory where
# `playwright install chromium` (matching this project's Playwright version) has
# run. Do NOT hardcode a browser revision anywhere — Playwright resolves it.
# PLAYWRIGHT_BROWSERS_PATH=

# NEVER set NODE_TLS_REJECT_UNAUTHORIZED=0 in production — it disables TLS verification.
