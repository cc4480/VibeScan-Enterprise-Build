# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Tool caches
.cache/
.local/

# Local env files (.env is only used for local dev and must never be committed)
.env
.env.local
.env.*.local
# Every other env file is secret by default: production values, hand-made copies. The
# committed templates are un-ignored below.
.env.production
.env.*
!.env.*.example
!.env.example
# Filled-in config for the Docker stack; .env.docker.example is the template.
.env.docker

# Cross-scanner benchmark output (scripts/benchmark/README.md) — regenerated by
# every run, so not tracked by default. A specific dated result gets committed
# deliberately, as its own snapshot, when something is published from it — see
# scripts/benchmark/results/ for those. Unanchored, because `pnpm --filter
# @workspace/api-server run benchmark` writes it inside artifacts/api-server/.
benchmark-out/

# The public secscan-me fault manifest is generated per deployment (a real
# --app-version stamped at deploy time), not a static file to track in git.
# See artifacts/api-server/scripts/benchmark/generate-manifest.ts.
/artifacts/vuln-fixture/manifest.json
.secscan.log
.web.log
.railway-secrets/
